<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="my_sweetshop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:main="clr-namespace:my_sweetshop.Views.Main"
    xmlns:catalog="clr-namespace:my_sweetshop.Views.Catalog"
    xmlns:contact="clr-namespace:my_sweetshop.Views.Contact"
    xmlns:profile="clr-namespace:my_sweetshop.Views.Profile"

    Shell.NavBarIsVisible="False">

    <TabBar>

        <ShellContent
            Title="Главная"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate main:HomePage}" />

        <ShellContent
            Title="Каталог"
            Icon="tab_catalog.png"
            ContentTemplate="{DataTemplate catalog:CatalogPage}" />

        <ShellContent
            Title="Связаться"
            Icon="tab_contact.png"
            ContentTemplate="{DataTemplate contact:ContactPage}" />

        <ShellContent
            Title="Профиль"
            Icon="tab_profile.png"
            ContentTemplate="{DataTemplate profile:ProfilePage}" />

    </TabBar>

</Shell>