<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="my_sweetshop.Views.Profile.EditProfilePage"
             Title="EditProfile">
    <Grid RowDefinitions="Auto,*">

        <!-- Заголовок -->
        <Grid Padding="16" ColumnDefinitions="Auto,*">
            <ImageButton Source="back.png"
                         WidthRequest="28"
                         HeightRequest="28"
                         Command="{Binding BackCommand}"/>

            <Label Text="Редактировать профиль"
                   Grid.Column="1"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontAttributes="Bold"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="14">

                <Label Text="Новое имя:"/>
                <Entry Placeholder="Введите имя"
                       Text="{Binding NewName}" />

                <Label Text="Новая фамилия:"/>
                <Entry Placeholder="Введите фамилию"
                       Text="{Binding NewSurname}" />

                <Label Text="Новая почта:"/>
                <Entry Placeholder="Введите почту"
                       Text="{Binding NewEmail}" />

                <Button Text="Сменить почту"
                        Command="{Binding GoToChangeEmailCommand}"/>

                <Grid HeightRequest="40"/>

                <Button Text="Сохранить"
                        Command="{Binding SaveCommand}"
                        HorizontalOptions="Center"
                        WidthRequest="200"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>