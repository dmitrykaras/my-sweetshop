<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="my_sweetshop.Views.Catalog.CatalogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Каталог">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshCommand}">

        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="24">

                <Label
                    Text="Каталог товаров"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalOptions="Start" />

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="ДЕСЕРТЫ"
                        FontSize="14"
                        TextColor="#9E9E9E"
                        FontAttributes="Bold" />

                    <Border Style="{StaticResource CategoryContainerStyle}">
                        <CollectionView
                            ItemsSource="{Binding Desserts}"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <VerticalStackLayout Padding="10" Spacing="8">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                HeightRequest="300"
                                                Aspect="AspectFill" />
                                            <Label
                                                Text="{Binding Name}"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Text="Описание"
                                                BackgroundColor="White"
                                                TextColor="Black"
                                                BorderColor="LightGray"
                                                BorderWidth="1"
                                                CornerRadius="5"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Margin="0"
                                                Command="{Binding BindingContext.OpenProductCommand,
                                                          Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="МУЖСКИЕ ТОРТЫ"
                        FontSize="14"
                        TextColor="#9E9E9E"
                        FontAttributes="Bold" />

                    <Border Style="{StaticResource CategoryContainerStyle}">
                        <CollectionView
                            ItemsSource="{Binding MaleCakes}"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <VerticalStackLayout Padding="10" Spacing="8">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                HeightRequest="160"
                                                Aspect="AspectFill" />
                                            <Label
                                                Text="{Binding Name}"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Text="Описание"
                                                BackgroundColor="White"
                                                TextColor="Black"
                                                BorderColor="LightGray"
                                                BorderWidth="1"
                                                CornerRadius="5"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Margin="0"
                                                Command="{Binding BindingContext.OpenProductCommand,
                                                          Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="ЖЕНСКИЕ ТОРТЫ"
                        FontSize="14"
                        TextColor="#9E9E9E"
                        FontAttributes="Bold" />

                    <Border Style="{StaticResource CategoryContainerStyle}">
                        <CollectionView
                            ItemsSource="{Binding FemaleCakes}"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <VerticalStackLayout Padding="10" Spacing="8">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                HeightRequest="160"
                                                Aspect="AspectFill" />
                                            <Label
                                                Text="{Binding Name}"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Text="Описание"
                                                BackgroundColor="White"
                                                TextColor="Black"
                                                BorderColor="LightGray"
                                                BorderWidth="1"
                                                CornerRadius="5"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Margin="0"
                                                Command="{Binding BindingContext.OpenProductCommand,
                                                          Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="ДЕТСКИЕ ТОРТЫ"
                        FontSize="14"
                        TextColor="#9E9E9E"
                        FontAttributes="Bold" />

                    <Border Style="{StaticResource CategoryContainerStyle}">
                        <CollectionView
                            ItemsSource="{Binding KidsCakes}"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <VerticalStackLayout Padding="10" Spacing="8">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                HeightRequest="160"
                                                Aspect="AspectFill" />
                                            <Label
                                                Text="{Binding Name}"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Text="Описание"
                                                BackgroundColor="White"
                                                TextColor="Black"
                                                BorderColor="LightGray"
                                                BorderWidth="1"
                                                CornerRadius="5"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Margin="0"
                                                Command="{Binding BindingContext.OpenProductCommand,
                                                          Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="СВАДЕБНЫЕ ТОРТЫ"
                        FontSize="14"
                        TextColor="#9E9E9E"
                        FontAttributes="Bold" />

                    <Border Style="{StaticResource CategoryContainerStyle}">
                        <CollectionView
                            ItemsSource="{Binding WeddingCakes}"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <VerticalStackLayout Padding="10" Spacing="8">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                HeightRequest="300"
                                                Aspect="AspectFill" />
                                            <Label
                                                Text="{Binding Name}"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Text="Описание"
                                                BackgroundColor="White"
                                                TextColor="Black"
                                                BorderColor="LightGray"
                                                BorderWidth="1"
                                                CornerRadius="5"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Margin="0"
                                                Command="{Binding BindingContext.OpenProductCommand,
                                                          Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="НАБОРЫ"
                        FontSize="14"
                        TextColor="#9E9E9E"
                        FontAttributes="Bold" />

                    <Border Style="{StaticResource CategoryContainerStyle}">
                        <CollectionView
                            ItemsSource="{Binding Sets}"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <VerticalStackLayout Padding="10" Spacing="8">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                HeightRequest="160"
                                                Aspect="AspectFill" />
                                            <Label
                                                Text="{Binding Name}"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Text="Описание"
                                                BackgroundColor="White"
                                                TextColor="Black"
                                                BorderColor="LightGray"
                                                BorderWidth="1"
                                                CornerRadius="5"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Margin="0"
                                                Command="{Binding BindingContext.OpenProductCommand,
                                                          Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="НАПИТКИ"
                        FontSize="14"
                        TextColor="#9E9E9E"
                        FontAttributes="Bold" />

                    <Border Style="{StaticResource CategoryContainerStyle}">
                        <CollectionView
                            ItemsSource="{Binding Drinks}"
                            ItemsLayout="HorizontalList"
                            HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCardStyle}">
                                        <VerticalStackLayout Padding="10" Spacing="8">
                                            <Image
                                                Source="{Binding ImageUrl}"
                                                HeightRequest="250"
                                                Aspect="AspectFill" />
                                            <Label
                                                Text="{Binding Name}"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold" />

                                            <Button
                                                Text="Описание"
                                                BackgroundColor="White"
                                                TextColor="Black"
                                                BorderColor="LightGray"
                                                BorderWidth="1"
                                                CornerRadius="5"
                                                HorizontalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="15"
                                                Margin="0"
                                                Command="{Binding BindingContext.OpenProductCommand,
                                                          Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>