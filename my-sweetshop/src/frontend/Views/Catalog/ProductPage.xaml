<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="my_sweetshop.Views.Catalog.ProductPage"
    Title="Товар"
    Shell.NavBarIsVisible="True">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto" Padding="0,0,16,0" VerticalOptions="Center">
            <Label 
                Text="Товар" 
                FontSize="20" 
                FontAttributes="Bold" 
                VerticalTextAlignment="Center" />

            <ImageButton 
                Grid.Column="1"
                x:Name="FavoriteBtn"
                Clicked="OnFavoriteClicked"
                WidthRequest="40" 
                HeightRequest="40" 
                HorizontalOptions="End" 
                BackgroundColor="Transparent"/>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Image
                Source="{Binding ImageUrl}"
                HeightRequest="600"
                Aspect="AspectFill" />

            <Label
                Text="{Binding Name}"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding Description}"
                FontSize="16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>