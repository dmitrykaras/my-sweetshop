<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="my_sweetshop.Views.Catalog.CatalogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Каталог">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">

            <!-- Заголовок -->
            <Label
                Text="Каталог товаров"
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Start" />

            <!-- ================= ДЕСЕРТЫ ================= -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="ДЕСЕРТЫ"
                    FontSize="14"
                    TextColor="#9E9E9E"
                    FontAttributes="Bold" />

                <Border Style="{StaticResource CategoryContainerStyle}">

                    <CollectionView
                        ItemsSource="{Binding Desserts}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource ProductCardStyle}">

                                    <VerticalStackLayout Padding="10" Spacing="8">

                                        <Image
                                            Source="{Binding Image}"
                                            HeightRequest="160"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="{Binding Name}"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold" />

                                        <Button
                                            Text="Описание"
                                            HorizontalOptions="Center"
                                            Command="{Binding BindingContext.OpenProductCommand,
                                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Border>
            </VerticalStackLayout>

            <!-- ================= МУЖСКИЕ ТОРТЫ ================= -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="МУЖСКИЕ ТОРТЫ"
                    FontSize="14"
                    TextColor="#9E9E9E"
                    FontAttributes="Bold" />

                <Border Style="{StaticResource CategoryContainerStyle}">

                    <CollectionView
                        ItemsSource="{Binding MaleCakes}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource ProductCardStyle}">

                                    <VerticalStackLayout Padding="10" Spacing="8">

                                        <Image
                                            Source="{Binding Image}"
                                            HeightRequest="160"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="{Binding Name}"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold" />

                                        <Button
                                            Text="Описание"
                                            HorizontalOptions="Center"
                                            Command="{Binding BindingContext.OpenProductCommand,
                                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Border>
            </VerticalStackLayout>

            <!-- ================= ЖЕНСКИЕ ТОРТЫ ================= -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="ЖЕНСКИЕ ТОРТЫ"
                    FontSize="14"
                    TextColor="#9E9E9E"
                    FontAttributes="Bold" />

                <Border Style="{StaticResource CategoryContainerStyle}">

                    <CollectionView
                        ItemsSource="{Binding FemaleCakes}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource ProductCardStyle}">

                                    <VerticalStackLayout Padding="10" Spacing="8">

                                        <Image
                                            Source="{Binding Image}"
                                            HeightRequest="160"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="{Binding Name}"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold" />

                                        <Button
                                            Text="Описание"
                                            HorizontalOptions="Center"
                                            Command="{Binding BindingContext.OpenProductCommand,
                                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Border>
            </VerticalStackLayout>

            <!-- ================= ДЕТСКИЕ ТОРТЫ ================= -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="ДЕТСКИЕ ТОРТЫ"
                    FontSize="14"
                    TextColor="#9E9E9E"
                    FontAttributes="Bold" />

                <Border Style="{StaticResource CategoryContainerStyle}">

                    <CollectionView
                        ItemsSource="{Binding KidsCakes}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource ProductCardStyle}">

                                    <VerticalStackLayout Padding="10" Spacing="8">

                                        <Image
                                            Source="{Binding Image}"
                                            HeightRequest="160"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="{Binding Name}"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold" />

                                        <Button
                                            Text="Описание"
                                            HorizontalOptions="Center"
                                            Command="{Binding BindingContext.OpenProductCommand,
                                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Border>
            </VerticalStackLayout>

            <!-- ================= СВАДЕБНЫЕ ТОРТЫ ================= -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="СВАДЕБНЫЕ ТОРТЫ"
                    FontSize="14"
                    TextColor="#9E9E9E"
                    FontAttributes="Bold" />

                <Border Style="{StaticResource CategoryContainerStyle}">

                    <CollectionView
                        ItemsSource="{Binding WeddingCakes}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource ProductCardStyle}">

                                    <VerticalStackLayout Padding="10" Spacing="8">

                                        <Image
                                            Source="{Binding Image}"
                                            HeightRequest="160"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="{Binding Name}"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold" />

                                        <Button
                                            Text="Описание"
                                            HorizontalOptions="Center"
                                            Command="{Binding BindingContext.OpenProductCommand,
                                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Border>
            </VerticalStackLayout>

            <!-- ================= НАБОРЫ ================= -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="НАБОРЫ"
                    FontSize="14"
                    TextColor="#9E9E9E"
                    FontAttributes="Bold" />

                <Border Style="{StaticResource CategoryContainerStyle}">

                    <CollectionView
                        ItemsSource="{Binding Sets}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource ProductCardStyle}">

                                    <VerticalStackLayout Padding="10" Spacing="8">

                                        <Image
                                            Source="{Binding Image}"
                                            HeightRequest="160"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="{Binding Name}"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold" />

                                        <Button
                                            Text="Описание"
                                            HorizontalOptions="Center"
                                            Command="{Binding BindingContext.OpenProductCommand,
                                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Border>
            </VerticalStackLayout>

            <!-- ================= НАПИТКИ ================= -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="НАПИТКИ"
                    FontSize="14"
                    TextColor="#9E9E9E"
                    FontAttributes="Bold" />

                <Border Style="{StaticResource CategoryContainerStyle}">

                    <CollectionView
                        ItemsSource="{Binding Drinks}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Style="{StaticResource ProductCardStyle}">

                                    <VerticalStackLayout Padding="10" Spacing="8">

                                        <Image
                                            Source="{Binding Image}"
                                            HeightRequest="160"
                                            Aspect="AspectFill" />

                                        <Label
                                            Text="{Binding Name}"
                                            HorizontalOptions="Center"
                                            FontAttributes="Bold" />

                                        <Button
                                            Text="Описание"
                                            HorizontalOptions="Center"
                                            Command="{Binding BindingContext.OpenProductCommand,
                                                      Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>