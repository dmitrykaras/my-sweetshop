<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="my_sweetshop.Views.Auth.CompletionProfilePage"
             Title="Профиль">

    <Grid Padding="24" RowDefinitions="Auto,*,Auto">

        <!-- Заголовок -->
        <Label Text="Введите свои данные:"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center"
               Margin="0,12,0,0"/>

        <!-- Поля ввода -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="18"
                             VerticalOptions="Center">

            <Grid>
                <Entry x:Name="FirstNameEntry"
                       Placeholder="Ваше имя"
                       TextChanged="OnEntryTextChanged"/>
                <Button x:Name="ClearFirstNameBtn"
                        Text="✕"
                        IsVisible="False"
                        WidthRequest="32"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Clicked="OnClearFirstName"/>
            </Grid>

            <Grid>
                <Entry x:Name="LastNameEntry"
                       Placeholder="Ваша фамилия"
                       TextChanged="OnEntryTextChanged"/>
                <Button x:Name="ClearLastNameBtn"
                        Text="✕"
                        IsVisible="False"
                        WidthRequest="32"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Clicked="OnClearLastName"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Кнопка Продолжить -->
        <Button x:Name="ContinueBtn"
                Grid.Row="2"
                Text="Продолжить"
                TextColor="White"
                CornerRadius="16"
                HeightRequest="52"
                HorizontalOptions="Center"
                IsEnabled="False"
                Clicked="OnContinueClicked"/>
    </Grid>
</ContentPage>