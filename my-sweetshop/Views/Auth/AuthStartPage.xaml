<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="my_sweetshop.Views.Auth.AuthStartPage"
             Title="AuthStartPage">
    <Grid Padding="24" RowDefinitions="Auto,*,Auto">

        <Label Text="Добро пожаловать"
            FontSize="24"
            FontAttributes="Bold"
            TextColor="Black"
            Margin="0,12,0,0"/>

        <VerticalStackLayout Grid.Row="1" Spacing="18" VerticalOptions="Center">
            <Image Source="logo_1.png"
                HeightRequest="140"
                HorizontalOptions="Center"/>

            <Label Text="Десерты и скидки в одном месте"
                HorizontalTextAlignment="Center"
                FontSize="16"
                TextColor="#444"/>
        </VerticalStackLayout>

        <Button Grid.Row="2"
            Text="Вход / Регистрация"
            BackgroundColor="#f6ed46"
            TextColor="Black"
            CornerRadius="16"
            HeightRequest="52"
            Clicked="OnStartClicked"/>
    </Grid>
</ContentPage>